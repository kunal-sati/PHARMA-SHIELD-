# PharmaShield Environment Variables Example
PORT=8000
HOST=0.0.0.0
ENVIRONMENT=development

# Database Configuration
DATABASE_URL=sqlite:///./pharmashield.db
# PostgreSQL Alternative: postgresql://user:password@localhost:5432/pharmashield

# AI Engine Configuration
AI_API_KEY=your_gemini_api_key_here
AI_MODEL_NAME=gemini-1.5-pro

# SAP Integration
SAP_BASE_URL=https://sap-gateway.example.com
SAP_CLIENT_ID=mock_sap_client_id
SAP_CLIENT_SECRET=mock_sap_client_secret
SAP_MODE=MOCK

# Security & Authentication
JWT_SECRET=super_secret_pharmashield_jwt_key_2026_change_in_production
JWT_ALGORITHM=HS256
ACCESS_TOKEN_EXPIRE_MINUTES=480

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:3000
